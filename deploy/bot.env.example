# Copy this to /opt/funfact-bot/bot.env and fill in the values.
# This file is read by the systemd service (see deploy/funfact-bot.service)
# and is the recommended place for secrets on the server.

# ---- Twitch ----
# The bot channel to join (without the #).
TWITCH_CHANNEL=truckingwithdoc
# The bot account's login name (the account you authorized).
TWITCH_NICK=truckingwithdocbot
# Your free app Client ID from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=

# ---- Fact mode ----
# "spicy" for adult-aligned trucker facts, "clean" for family-friendly.
TWITCH_SPICE=spicy

# ---- LLM (optional, used in spicy mode) ----
# Pick ONE. OpenRouter (uncensored-ish models) or Groq.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nousresearch/hermes-4-70b
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Debug (temporary) ----
# Set to 1 to print every prompt/response the bot sends to the LLM.
# TWITCH_DEBUG=1

# ---- Optional second search source (fixes "wikipedia rate-limited") ----
# Serper key from https://serper.dev (free tier: 2,500 queries).
# SERPER_API_KEY=
