# Secrets - never commit these. Keep them when you update the bot's files.
tokens.json
config.json
# The bot's own state, written at runtime
reminders.json
haul.json
transporting.json

# Python
__pycache__/
*.pyc

# harvested !smk name cache (rebuilt in the background, never hand-edited)
names.json
custom_commands.json

# the beef game scoreboard and !revenge windows
beef_state.json

# The chat AI's memory (runtime data, not code)
chat_memory.db*

# the mod-chosen voice and the sub goal (runtime state)
persona.json
subgoal.json
# the chat AI's working memory: the game it is hosting, the counts it keeps
ongoing.json
*.log

# admin panel logins (salted hashes, but still yours alone)
admin_users.json
